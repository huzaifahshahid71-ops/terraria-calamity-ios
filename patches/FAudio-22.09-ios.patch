 uint32_t FAudio_PlatformGetDeviceCount()
 {
-	uint32_t devCount = SDL_GetNumAudioDevices(0);
-	if (devCount == 0)
+	/* Terraria iOS port: SDL cannot enumerate output devices on iOS (returns 0, or -1 which wrapped to a huge
