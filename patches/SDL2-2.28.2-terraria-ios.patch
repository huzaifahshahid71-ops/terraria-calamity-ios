+/* ---- UIScene lifecycle support (iOS 27 traps apps without it). Added for the Terraria/tModLoader iOS port. ---- */
+UIWindowScene *SDL_UIKit_activeScene API_AVAILABLE(ios(13.0)) = nil;
+static BOOL SDL_UIKit_usesScenes = NO;
