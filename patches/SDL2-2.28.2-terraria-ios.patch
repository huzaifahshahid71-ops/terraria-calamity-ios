+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+/* Exported: called by SDLUIKitSceneDelegate, or by a host-provided scene delegate (e.g. when the app runs inside
+ * LiveContainer, which connects scenes using the guest Info.plist delegate rather than the app delegate's configuration). */
+DECLSPEC void SDLCALL SDL_UIKit_SceneDidConnect(void *sceneptr)
+{
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        UIScene *scene = (__bridge UIScene *)sceneptr;
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            SDL_UIKit_Trace("SceneDidConnect: not a UIWindowScene");
+            return;
+        }
+        SDL_UIKit_activeScene = (UIWindowScene *)scene;
+        SDL_UIKit_Trace("SceneDidConnect");
+        for (UIWindow *w in [UIApplication sharedApplication].windows) {
+            SDL_UIKit_AttachWindowToScene(w);
+        }
+        if (!SDL_UIKit_mainStarted) {
+            SDL_UIKit_mainStarted = YES;
+            id del = [UIApplication sharedApplication].delegate;
+            if ([del respondsToSelector:@selector(postFinishLaunch)]) {
+                [del performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+            } else {
+                /* host app delegate is not SDL's (LiveContainer): run SDL's launch path on a fresh SDL delegate instance */
+                SDL_UIKit_Trace("SceneDidConnect: app delegate is not SDL's; using private SDLUIKitDelegate instance");
+                static SDLUIKitDelegate *sdlDelegate = nil;
+                sdlDelegate = [[SDLUIKitDelegate alloc] init];
+                [sdlDelegate performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+            }
+        }
+    }
+}
