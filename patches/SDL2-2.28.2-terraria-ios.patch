+/* v29 renderer selection (Terraria port). Metal = FNA3D Vulkan driver on the bundled MoltenVK.framework.
+ * Crash guard: TPMetalPending is set before a Metal launch and cleared by the overlay after ~20 s of running;
+ * if a Metal launch never confirms, the next launch uses OpenGL ES and the setting reverts to OpenGL. */
+static void TP_ConfigureRenderer(void)
+{
+    @autoreleasepool {
+        NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+        /* v31: capture native stderr (MoltenVK / FNA3D / SDL diagnostics) to Documents/native-stderr.txt each launch */
+        NSString *docs = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+        if (docs) { freopen([[docs stringByAppendingPathComponent:@"native-stderr.txt"] UTF8String], "w", stderr); setvbuf(stderr, NULL, _IOLBF, 0); }
+        setenv("MVK_CONFIG_LOG_LEVEL", "2", 0); /* warnings and errors */
+        setenv("TP_BAKED_IL", ([d objectForKey:@"TPBakedIL"] && ![d boolForKey:@"TPBakedIL"]) ? "0" : "1", 1); /* gear menu: AOT Calamity edits */
+        setenv("TP_LAZY_TEXTURES", ([d objectForKey:@"TPLazyTextures"] && ![d boolForKey:@"TPLazyTextures"]) ? "0" : "1", 1); /* gear menu: Low-memory textures */
+        NSString *renderer = [d stringForKey:@"TPRenderer"] ?: @"metal";
+        BOOL hud = [d objectForKey:@"TPMetalHUD"] ? [d boolForKey:@"TPMetalHUD"] : YES;
+        NSString *mvk = nil; Dl_info info;
+        if (dladdr((const void *) &SDL_UIKitRunApp, &info) && info.dli_fname) {
+            NSString *frameworks = [[@(info.dli_fname) stringByDeletingLastPathComponent] stringByDeletingLastPathComponent];
+            mvk = [frameworks stringByAppendingPathComponent:@"MoltenVK.framework/MoltenVK"];
+        }
+        BOOL haveMVK = mvk && [NSFileManager.defaultManager fileExistsAtPath:mvk];
+        if ([d boolForKey:@"TPMetalPending"]) {
+            [d setBool:NO forKey:@"TPMetalPending"]; [d setObject:@"opengl" forKey:@"TPRenderer"]; [d synchronize];
+            renderer = @"opengl";
+            SDL_UIKit_Trace("renderer: previous Metal launch never confirmed -> OpenGL ES (re-enable Metal in the gear menu)");
+        }
+        if ([renderer isEqualToString:@"metal"] && haveMVK) {
+            setenv("SDL_VULKAN_LIBRARY", mvk.UTF8String, 1);
+            setenv("FNA3D_FORCE_DRIVER", "Vulkan", 1);
+            if (hud) setenv("MTL_HUD_ENABLED", "1", 1);
+            [d setBool:YES forKey:@"TPMetalPending"]; [d synchronize];
+            SDL_UIKit_Trace([[NSString stringWithFormat:@"renderer: Metal (FNA3D Vulkan on MoltenVK %@) hud=%d", mvk, hud] UTF8String]);
+        } else {
+            setenv("FNA3D_FORCE_DRIVER", "OpenGL", 1);
+            SDL_UIKit_Trace([[NSString stringWithFormat:@"renderer: OpenGL ES (setting=%@ moltenvk=%d)", renderer, haveMVK] UTF8String]);
+        }
+    }
+}
