+/* Port diagnostics: append a line to Documents/sdl-trace.txt (survives silent exits). */
+void SDL_UIKit_Trace(const char *what)
+{
+    @autoreleasepool {
+        NSString *dir = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+        if (!dir) { return; }
+        NSString *line = [NSString stringWithFormat:@"%@ %s\n", [NSDate date], what];
+        NSString *path = [dir stringByAppendingPathComponent:@"sdl-trace.txt"];
+        NSFileHandle *h = [NSFileHandle fileHandleForWritingAtPath:path];
+        if (!h) { [[NSFileManager defaultManager] createFileAtPath:path contents:nil attributes:nil]; h = [NSFileHandle fileHandleForWritingAtPath:path]; }
+        [h seekToEndOfFile]; [h writeData:[line dataUsingEncoding:NSUTF8StringEncoding]]; [h closeFile];
+    }
+}
