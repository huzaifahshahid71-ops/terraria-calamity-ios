+
+void SDL_UIKit_AttachWindowToScene(UIWindow *window)
+{
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        if (window != nil && SDL_UIKit_activeScene != nil && window.windowScene != SDL_UIKit_activeScene) {
+            window.windowScene = SDL_UIKit_activeScene;
+        }
+        if (window != nil && window.windowScene != nil) {
+            /* UIScreen.bounds can still describe portrait inside a landscape host.
+             * A scene-attached window must fill the scene's own coordinate space. */
+            CGRect bounds = window.windowScene.coordinateSpace.bounds;
+            if (!CGRectEqualToRect(window.frame, bounds)) window.frame = bounds;
+            SDL_UIKit_Trace([[NSString stringWithFormat:@"scene window frame=%@ scene=%@", NSStringFromCGRect(window.frame), NSStringFromCGRect(bounds)] UTF8String]);
+        }
+    }
+}
